    },
    "kocaeli-bus-directory.json": {
      "kind": "scraped",
      "source": "Kocaeli BB / UlaşımPark route pages",
      "licence": "no open-data licence",
      "covers": "Kocaeli bus routes"
    },
    "kocaeli-bus-graph.json": {
      "kind": "scraped",
      "source": "Kocaeli BB / UlaşımPark route pages",
      "licence": "no open-data licence",
      "covers": "Kocaeli bus stops in order"
    },
    "kocaeli-bus-schedules.json": {
      "kind": "scraped",
      "source": "Kocaeli BB / UlaşımPark route pages",
      "licence": "no open-data licence",
      "covers": "Kocaeli bus timetables"
