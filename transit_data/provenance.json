{
  "note": "Where every shipped dataset comes from and how far it can be trusted. build.cjs adds each file's real modification time, so freshness is measured rather than claimed. kind drives how the app words itself: 'operator' data may be stated plainly, 'community' and 'scraped' must be labelled.",
  "kinds": {
    "operator": "Published by the transport operator. Exact; may be stated without qualification.",
    "official": "Published by a public authority, but not the operator's own timetable.",
    "community": "OpenStreetMap. Real, but coverage is uneven and there are no timetables — must be labelled.",
    "scraped": "Read from a provider's web page with no open-data licence. Accurate when fetched, no guarantee of continuity.",
    "curated": "Compiled by hand for this project from published sources. Subject to human error and to change."
  },
  "datasets": {
    "lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "İstanbul rail geometry and stations"
    },
    "b2-line.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "B2 suburban line"
    },
    "ferry-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap + hand-drawn Bosphorus shore lines",
      "licence": "ODbL 1.0",
      "covers": "İstanbul ferries; two shore routes have no OSM geometry and are approximated"
    },
    "cable-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "TF1/TF2 aerial cable cars"
    },
    "planned-lines.json": {
      "kind": "curated",
      "source": "metro.istanbul project pages",
      "licence": "n/a",
      "covers": "Lines under construction"
    },
    "planned-manual.json": {
      "kind": "curated",
      "source": "İBB announcements, hand-placed",
      "licence": "n/a",
      "covers": "In-planning lines with approximate alignments"
    },
    "ankara-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "EGO metro, Ankaray, Başkentray"
    },
    "izmir-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "İzmir Metro, İZBAN, trams"
    },
    "bursa-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "BursaRay and trams"
    },
    "antalya-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "AntRay tram lines"
    },
    "kocaeli-lines.json": {
      "kind": "community",
      "source": "OpenStreetMap via Overpass",
      "licence": "ODbL 1.0",
      "covers": "Akçaray trams and projects"
    },
    "intercity-lines.json": {
      "kind": "curated",
      "source": "TCDD Taşımacılık published routes",
      "licence": "n/a",
      "covers": "National rail, YHT and main line"
    },
    "bus-directory.json": {
      "kind": "operator",
      "source": "İETT line list",
      "licence": "İBB Open Data terms",
      "covers": "İstanbul bus routes; 40 rows are reconstructed from the GTFS graph because the line list omits them"
    },
    "bus-graph.json": {
      "kind": "operator",
      "source": "İETT GTFS",
      "licence": "İBB Open Data terms",
      "covers": "İstanbul bus stops in order"
    },
    "bus-schedules.json": {
      "kind": "operator",
      "source": "İETT GTFS",
      "licence": "İBB Open Data terms",
      "covers": "İstanbul bus first/last/headway per day type — exact"
    },
    "bus-geom.json": {
      "kind": "operator",
      "source": "İETT GTFS shapes",
      "licence": "İBB Open Data terms",
